  },
  "attestation": {
    "nonce_bytes": 32,
    "freeze_complete_source_tree": true,
    "freeze_required_task_data_trees": true,
    "record_argv_and_process_boundaries": true,
    "require_pre_aggregate_evidence_manifest": true,
