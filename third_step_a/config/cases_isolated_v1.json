    "api_log_redaction": {
      "scheme": "sha256(run_nonce || kind || canonical_value)[:16]",
      "replacement_format": "<REDACTED:KIND:16-hex>",
      "sensitive_key_fragments": [
        "access_token",
        "authorization",
        "bearer",
        "password",
        "secret",
        "username",
        "email",
        "phone",
        "message",
        "content",
        "amount",
        "result"
